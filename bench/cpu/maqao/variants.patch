+#include "chps/dp.hpp"
+#include <omp.h>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <iostream>
+int main() {
+    std::mt19937 rng(42);
+    for (int threads : {1, 4}) {
+        omp_set_num_threads(threads);
+        for (int len = 0; len <= 100; ++len) {
+            std::string a(len, 'A'), b;
+            for (auto& x : a) x = std::string_view("ACGTNG-R!")[rng() % 9];
+            b.resize(rng() % 118, 'A');
+            for (auto& x : b) x = std::string_view("ACGTNyyyy")[rng() % 9];
+            auto ref = chps::sequential(a,b,true);
+            if (chps::nvpd_omp(a,b,false).distance != ref.distance || chps::nvpd_omp(b,a,false).distance != ref.distance ||
+                chps::nvpd_omp(a,b,true).cigar != ref.cigar)
+                throw std::runtime_error("mismatch at "+std::to_string(len));
+        }
+    }
+    std::cout << "passed\n";
+}
