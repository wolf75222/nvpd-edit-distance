+#pragma once
+
+#include "chps/dp.hpp"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <omp.h>
+#include <string_view>
+#include <vector>
+#if defined(__AVX512F__)
+#include <immintrin.h>
+#endif
+
+namespace chps::detail {
+inline constexpr int block_lanes = 16;
+
+struct MatchBlock {
+    std::array<std::uint8_t, block_lanes> source;
+    int before;
+};
+
+inline void evaluate_block(int* current, const int* diagonal, int carry,
+                           const MatchBlock& block) {
+#if defined(__AVX512F__)
+    const auto one = _mm512_set1_epi32(1);
+    const auto diag = _mm512_loadu_si512(diagonal);
+    const auto top = _mm512_loadu_si512(diagonal + 1);
+    const auto labels = _mm512_cvtepu8_epi32(_mm_loadu_si128(
+        reinterpret_cast<const __m128i*>(block.source.data())));
+    const auto last = _mm512_permutex2var_epi32(diag, labels, _mm512_set1_epi32(carry));
+    const auto ordinary = _mm512_min_epi32(diag, _mm512_add_epi32(top, one));
+    _mm512_storeu_si512(current, _mm512_min_epi32(ordinary, _mm512_sub_epi32(last, one)));
+#else
+    for (int lane = 0; lane < block_lanes; ++lane) {
+        const int source = block.source[lane];
+        const int last = source < block_lanes ? diagonal[source] : carry;
+        current[lane] = std::min({diagonal[lane], diagonal[lane+1]+1, last-1});
+    }
+#endif
+}
+
+// With F(i,j) = D(i,j) - j, the last match contributes F(i-1,k-1) - 1.
+// Inside each block its source is either a local lane or the single match
+// preceding the whole block. Slot zero supplies the sentinel for k = 0.
+inline Result blocked_score(std::string_view a, std::string_view b) {
+    const auto blocks = (b.size() + block_lanes - 1) / block_lanes;
+    std::array<unsigned char, 256> alphabet;
+    std::array<int, 256> symbols;
+    symbols.fill(-1);
+    int count = 0;
+    for (unsigned char c : a) {
+        if (symbols[c] < 0) {
+            alphabet[count] = c;
+            symbols[c] = count++;
+        }
+    }
+    std::vector<MatchBlock> index(blocks * count);
+    #pragma omp parallel for schedule(static)
+    for (int s = 0; s < count; ++s) {
+        int last = 0;
+        for (std::size_t chunk = 0; chunk < blocks; ++chunk) {
+            const int first = static_cast<int>(chunk * block_lanes + 1);
+            auto& block = index[s * blocks + chunk];
+            block.before = last;
+            int source = block_lanes;
+            for (int lane = 0; lane < block_lanes; ++lane) {
+                const auto position = chunk * block_lanes + lane;
+                if (position < b.size() && static_cast<unsigned char>(b[position]) == alphabet[s]) {
+                    last = first + lane;
+                    source = lane;
+                }
+                block.source[lane] = static_cast<std::uint8_t>(source);
+            }
+        }
+    }
+    const std::size_t pitch = blocks * block_lanes + 2;
+    std::vector<int> rows(2 * pitch);
+    rows[0] = 1;
+    #pragma omp parallel
+    {
+        for (int i = 1; i <= static_cast<int>(a.size()); ++i) {
+            const int* prev = rows.data() + ((i - 1) % 2) * pitch;
+            int* curr = rows.data() + (i % 2) * pitch;
+            if (omp_get_thread_num() == 0) {
+                curr[0] = i + 1;
+                curr[1] = i;
+            }
+            const auto s = symbols[static_cast<unsigned char>(a[i-1])];
+            const auto* matches = index.data() + s * blocks;
+            #pragma omp for schedule(static)
+            for (std::size_t chunk = 0; chunk < blocks; ++chunk) {
+                const auto first = chunk * block_lanes + 1;
+                const auto& block = matches[chunk];
+                evaluate_block(curr + first + 1, prev + first, prev[block.before], block);
+            }
+        }
+    }
+    return {rows[(a.size() % 2) * pitch + b.size() + 1] + static_cast<int>(b.size()), "", 0};
+}
+} // namespace chps::detail
