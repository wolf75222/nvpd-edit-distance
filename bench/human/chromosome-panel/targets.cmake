if(PROJECT_NAME STREQUAL "chps_edit_distance" AND NOT TARGET panel_simd)
    foreach(variant IN ITEMS initial scalar simd)
        if(variant STREQUAL "initial")
            set(reader "${PANEL_INITIAL}")
        elseif(variant STREQUAL "scalar")
            set(reader "${PANEL_SCALAR}")
        else()
            set(reader "${CMAKE_SOURCE_DIR}/src/io/fasta.cpp")
        endif()
        add_executable(panel_${variant} "${CMAKE_CURRENT_LIST_DIR}/trial.cpp" "${reader}")
        target_link_libraries(panel_${variant} PRIVATE distances)
        set_target_properties(panel_${variant} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
    endforeach()
    set_source_files_properties("${PANEL_SCALAR}" PROPERTIES COMPILE_OPTIONS "-fno-tree-vectorize")
    set_source_files_properties("${CMAKE_SOURCE_DIR}/src/io/fasta.cpp" PROPERTIES
                                COMPILE_OPTIONS "-fopt-info-vec-optimized=${CMAKE_BINARY_DIR}/parser.vec")
endif()
