if(PROJECT_NAME STREQUAL "chps_edit_distance" AND NOT TARGET human_kokkos)
  add_executable(human_kokkos "${CMAKE_CURRENT_LIST_DIR}/trial.cpp" "${CMAKE_SOURCE_DIR}/src/io/fasta.cpp")
  target_include_directories(human_kokkos PRIVATE "${CMAKE_SOURCE_DIR}/src/kokkos")
  target_link_libraries(human_kokkos PRIVATE distances)
  if(CHPS_HUMAN_PROFILE)
    find_package(CUDAToolkit REQUIRED)
    target_link_libraries(human_kokkos PRIVATE CUDA::cudart)
    target_compile_definitions(human_kokkos PRIVATE CHPS_HUMAN_PROFILE)
  endif()
  set_target_properties(human_kokkos PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
endif()
